# AI Utility Hub - Environment Variables
# Copy this file to .env and fill in your values

# AI API Key (required for real AI responses)
# Supports OpenAI, Qwen (via OpenRouter), Groq, or any OpenAI-compatible API
VITE_AI_API_KEY=

# AI API URL (optional - defaults to OpenAI)
# Examples:
#   OpenAI: https://api.openai.com/v1/chat/completions
#   OpenRouter: https://openrouter.ai/api/v1/chat/completions
#   Groq: https://api.groq.com/openai/v1/chat/completions
#   Qwen (via DashScope): https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VITE_AI_API_URL=https://api.openai.com/v1/chat/completions

# AI Model (optional - defaults to gpt-4o-mini)
# Examples:
#   OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
#   OpenRouter: qwen/qwen-2.5-72b-instruct, meta-llama/llama-3-70b-instruct
#   Groq: llama-3.1-70b-versatile, mixtral-8x7b-32768
#   Qwen: qwen-turbo, qwen-plus, qwen-max
VITE_AI_MODEL=gpt-4o-mini
